{
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/projeto/browser",
  "devCommand": "ng serve",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "MONGODB_URI": "@mongodb_uri"
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 3008
    }
  }
}
