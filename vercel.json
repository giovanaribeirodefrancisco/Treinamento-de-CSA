{
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/projeto/browser",
  "devCommand": "ng serve",
  "env": {
    "MONGODB_URI": "@mongodb_uri"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
