# Configuração do MongoDB
# Para produção, use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
# Para desenvolvimento local: mongodb://localhost:27017/treinamento-professores
MONGODB_URI=mongodb://localhost:27017/treinamento-professores

# Porta do servidor backend
PORT=3000

# Secret para JWT (GERAR UM VALOR ALEATÓRIO FORTE EM PRODUÇÃO!)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-change-in-production
